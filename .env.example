# Copy to .env at repository root. Never put database credentials in VITE_*.
DATABASE_URL=postgresql://clinic:CHANGE_ME@127.0.0.1:5432/dental_clinic?schema=public
HOST=127.0.0.1
PORT=4310
# npm run dev / desktop:start isolate the local development API on port 4311.
# Optional override for those launchers (do not use installed-server port 4310):
# NETDENTY_DEV_PORT=4311
# Must match the renderer origin; production renderer is served by this API.
APP_ORIGIN=http://127.0.0.1:4310
# true behind HTTPS; false only for loopback HTTP development/local desktop.
COOKIE_SECURE=false
SESSION_HOURS=12
# LOCAL owns a child API. REMOTE only opens API_BASE_URL and requires HTTPS except loopback.
DESKTOP_MODE=LOCAL
API_BASE_URL=http://127.0.0.1:4310
# Optional backend-only folder for patient uploads. Desktop uses its private user-data folder automatically.
# PATIENT_FILES_DIR=C:\NetDenty\patient-files
# Optional PostgreSQL bin folder when pg_dump/pg_restore are not in a standard installation location.
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
# Optional first-dentist CLI input. Prefer interactive prompt; never commit credentials.
# DENTIST_USERNAME=
# DENTIST_DISPLAY_NAME=
# DENTIST_PASSWORD=
# DENTIST_LANGUAGE=en
# Optional integration tests: dedicated disposable database, never your real database.
# TEST_DATABASE_URL=postgresql://clinic:CHANGE_ME@127.0.0.1:5432/dental_clinic_test?schema=public
