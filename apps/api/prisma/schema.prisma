generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  DENTIST
  ASSISTANT
  RECEPTIONIST
  ADMIN
}
enum Language {
  en
  fr
}
model User {
  id String @id @default(uuid())
  username String @unique @db.VarChar(64)
  passwordHash String
  displayName String @db.VarChar(100)
  role Role @default(DENTIST)
  preferredLanguage Language @default(en)
  defaultPage String @default("automatic") @db.VarChar(40)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  permissions ScreenPermission[]
  assignments RoomAssignment[]
  payments Payment[]
  labRequestsCreated LabRequest[] @relation("LabRequestCreatedBy")
  labRequestEvents LabRequestEvent[] @relation("LabRequestEventActor")
  patientFilesUploaded PatientFile[] @relation("PatientFileUploadedBy")
  billExpensesCreated BillExpense[] @relation("BillExpenseCreatedBy")
  purchaseInvoicesCreated PurchaseInvoice[] @relation("PurchaseInvoiceCreatedBy")
  appointments Appointment[] @relation("AppointmentDentist")
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentEvents AppointmentEvent[] @relation("AppointmentEventActor")
}
model Session {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique @db.Char(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model SystemLog {
  id String @id @default(uuid()) @db.Uuid
  level String @db.VarChar(10)
  source String @db.VarChar(12)
  code String @db.VarChar(80)
  message String @db.VarChar(500)
  details String @default("") @db.VarChar(4000)
  requestId String @default("") @db.VarChar(100)
  method String @default("") @db.VarChar(10)
  path String @default("") @db.VarChar(300)
  userId String? @db.Uuid
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([source, createdAt])
}

enum Currency {
  USD
  LBP
}

model CurrencySettings {
  id Int @id @default(1)
  baseCurrency Currency @default(USD)
  updatedAt DateTime @updatedAt
  @@index([roomId, fullName, id])
  @@index([roomId, phone, id])
  @@index([roomId, firstVisit, id])
}

model ExchangeRate {
  date DateTime @db.Date
  roomId Int @default(1)
  room SurgicalRoom @relation(fields: [roomId], references: [id])
  lbpPerUsd Decimal @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
  @@id([roomId, date])
}

model Patient {
  treatmentPlans TreatmentPlan[]
  chart PatientChart?
  clinicalRecords ClinicalRecord[]
  treatments Treatment[]
  payments Payment[]
  labRequests LabRequest[]
  files PatientFile[]
  appointments Appointment[]
  roomId Int @default(1)
  room SurgicalRoom @relation(fields: [roomId], references: [id])
  id Int @id @default(autoincrement())
  firstName String @db.VarChar(100)
  lastName String @db.VarChar(100)
  fullName String @db.VarChar(201)
  phone String @db.VarChar(40)
  gender String @db.VarChar(6)
  fatherName String @default("") @db.VarChar(100)
  job String @default("none") @db.VarChar(20)
  age Int @default(0)
  firstVisit DateTime @db.Date
  notes String @default("") @db.VarChar(4000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clinic {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  rooms SurgicalRoom[]
}
model SurgicalRoom {
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)
  clinicId Int
  clinic Clinic @relation(fields: [clinicId], references: [id])
  assignments RoomAssignment[]
  patients Patient[]
  procedures Procedure[]
  laboratories Laboratory[]
  rates ExchangeRate[]
  payments Payment[]
  labRequests LabRequest[]
  files PatientFile[]
  billCategories BillCategory[]
  billExpenses BillExpense[]
  suppliers Supplier[]
  supplyProducts SupplyProduct[]
  supplyItems SupplyItem[]
  purchaseInvoices PurchaseInvoice[]
  appointments Appointment[]
  @@unique([clinicId, name])
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  patientId Int?
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dentistId String
  dentist User @relation("AppointmentDentist", fields: [dentistId], references: [id], onDelete: Restrict)
  kind String @default("appointment") @db.VarChar(16)
  date DateTime @db.Date
  startMinutes Int
  durationMinutes Int
  status String @default("scheduled") @db.VarChar(20)
  visitReason String @default("") @db.VarChar(500)
  notes String @default("") @db.VarChar(4000)
  createdById String
  createdBy User @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events AppointmentEvent[]
  @@index([roomId, date, startMinutes])
  @@index([roomId, dentistId, date, startMinutes])
  @@index([patientId, date])
}

model AppointmentEvent {
  id String @id @default(uuid()) @db.Uuid
  appointmentId String @db.Uuid
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  action String @db.VarChar(24)
  data Json
  actorId String
  actor User @relation("AppointmentEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([appointmentId, createdAt])
}

model Supplier {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  phone String @default("") @db.VarChar(40)
  address String @default("") @db.VarChar(500)
  active Boolean @default(true)
  supplyItemLinks SupplyItemSupplier[]
  purchaseInvoices PurchaseInvoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([roomId, name])
  @@index([roomId, active, name])
  @@index([roomId, phone])
}

model SupplyProduct {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  variants SupplyItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([roomId, name])
  @@index([roomId, name])
}

model SupplyItem {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  productId Int
  product SupplyProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  brand String @db.VarChar(100)
  suppliers SupplyItemSupplier[]
  openingBalance Decimal @default(0) @db.Decimal(18, 3)
  defaultPrice Decimal @db.Decimal(18, 2)
  currency Currency
  date DateTime @db.Date
  expiryDate DateTime? @db.Date
  currentQuantity Decimal @default(0) @db.Decimal(18, 3)
  purchaseLines PurchaseInvoiceLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, brand])
  @@index([roomId, name])
  @@index([roomId, brand])
  @@index([roomId, productId])
  @@index([roomId, expiryDate])
}

model SupplyItemSupplier {
  itemId Int
  item SupplyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@id([itemId, supplierId])
  @@index([supplierId, itemId])
}

model PurchaseInvoice {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName String @db.VarChar(150)
  paymentType String @db.VarChar(12)
  currency Currency
  totalAmount Decimal @db.Decimal(18, 2)
  baseCurrency Currency
  baseTotal Decimal @db.Decimal(18, 2)
  lbpPerUsd Decimal? @db.Decimal(18, 6)
  date DateTime @db.Date
  note String @default("") @db.VarChar(4000)
  actorId String
  actor User @relation("PurchaseInvoiceCreatedBy", fields: [actorId], references: [id], onDelete: Restrict)
  lines PurchaseInvoiceLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([roomId, date])
  @@index([roomId, supplierId, date])
}

model PurchaseInvoiceLine {
  id Int @id @default(autoincrement())
  invoiceId Int
  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId Int
  item SupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemName String @db.VarChar(150)
  brand String @db.VarChar(100)
  defaultPrice Decimal @db.Decimal(18, 2)
  purchasePrice Decimal @db.Decimal(18, 2)
  quantity Decimal @db.Decimal(18, 3)
  expiryDate DateTime? @db.Date
  description String @default("") @db.VarChar(500)
  lineTotal Decimal @db.Decimal(18, 2)
  @@unique([invoiceId, itemId])
  @@index([itemId])
}

model BillCategory {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  description String @default("") @db.VarChar(2000)
  defaultAmount Decimal? @db.Decimal(18, 2)
  currency Currency @default(USD)
  laboratoryBills Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expenses BillExpense[]
  @@unique([roomId, name])
  @@index([roomId, active, name])
}

model BillExpense {
  id String @id @default(uuid()) @db.Uuid
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  categoryId Int
  category BillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryName String @db.VarChar(150)
  laboratoryId Int?
  laboratory Laboratory? @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  laboratoryName String? @db.VarChar(150)
  amount Decimal @db.Decimal(18, 2)
  currency Currency
  baseCurrency Currency
  baseAmount Decimal @db.Decimal(18, 2)
  lbpPerUsd Decimal? @db.Decimal(18, 6)
  method String @db.VarChar(16)
  date DateTime @db.Date
  note String @default("") @db.VarChar(4000)
  actorId String
  actor User @relation("BillExpenseCreatedBy", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([roomId, date])
  @@index([roomId, categoryId, date])
  @@index([roomId, laboratoryId, date])
}
model RoomAssignment {
  userId String
  roomId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room SurgicalRoom @relation(fields: [roomId], references: [id])
  @@id([userId, roomId])
}
model ScreenPermission {
  userId String
  screen String @db.VarChar(40)
  view Boolean @default(false)
  create Boolean @default(false)
  modify Boolean @default(false)
  delete Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, screen])
}

model Procedure {
  treatments Treatment[]
  laboratoryRates LaboratoryProcedureRate[]
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id])
  code String @db.VarChar(40)
  name String @db.VarChar(150)
  category String @db.VarChar(40)
  description String @default("") @db.VarChar(4000)
  defaultPrice Decimal @db.Decimal(12, 2)
  dentition String @db.VarChar(20)
  scope String @db.VarChar(20)
  requiresLab Boolean @default(false)
  labLaboratory String @default("") @db.VarChar(150)
  labDefaultCost Decimal @default(0) @db.Decimal(12, 2)
  labTurnaroundDays Int @default(0)
  labMaterial String @default("") @db.VarChar(100)
  labShade String @default("") @db.VarChar(40)
  labInstructions String @default("") @db.VarChar(2000)
  chartIndicator String @default("generic") @db.VarChar(30)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([roomId, code])
  @@index([roomId, id])
}

model Laboratory {
  id Int @id @default(autoincrement())
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  defaultCost Decimal @default(0) @db.Decimal(12, 2)
  turnaroundDays Int @default(0)
  material String @default("") @db.VarChar(100)
  shade String @default("") @db.VarChar(40)
  instructions String @default("") @db.VarChar(2000)
  active Boolean @default(true)
  treatments Treatment[]
  procedureRates LaboratoryProcedureRate[]
  billExpenses BillExpense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([roomId, name])
  @@index([roomId, active, name])
}

model LaboratoryProcedureRate {
  id Int @id @default(autoincrement())
  laboratoryId Int
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  procedureId Int
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  cost Decimal @db.Decimal(18, 2)
  currency Currency @default(USD)
  turnaroundDays Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([laboratoryId, procedureId])
  @@index([procedureId, active])
}

model PatientChart {
  patientId Int @id
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dentition String @db.VarChar(12)
  updatedAt DateTime @updatedAt
}

model ClinicalRecord {
  @@index([planId])
  planId String? @db.Uuid
  plan TreatmentPlan? @relation(fields: [planId, patientId], references: [id, patientId], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(12)
  data Json
  date DateTime @db.Date
  actorId String
  recordedAt DateTime @default(now())
  voidReason String?
  voidDate DateTime? @db.Date
  voidActorId String?
  @@index([patientId, kind, date])
  @@index([patientId, kind, recordedAt])
}

model Treatment {
  discountType String @default("amount") @db.VarChar(8)
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  @@index([planId])
  planId String? @db.Uuid
  plan TreatmentPlan? @relation(fields: [planId, patientId], references: [id, patientId], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedureId Int
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  laboratoryId Int?
  laboratory Laboratory? @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  snapshot Json
  price Decimal @db.Decimal(12, 2)
  currency String @default("USD") @db.VarChar(3)
  date DateTime @db.Date
  notes String
  status String @default("planned") @db.VarChar(16)
  version Int @default(1)
  voidReason String?
  replacesId String? @db.Uuid
  replaces Treatment? @relation("TreatmentCorrection", fields: [replacesId], references: [id], onDelete: Restrict)
  corrections Treatment[] @relation("TreatmentCorrection")
  teeth TreatmentTooth[]
  events TreatmentEvent[]
  labRequest LabRequest?
  createdAt DateTime @default(now())
  @@index([patientId, date])
  @@index([patientId, planId, createdAt])
  @@index([laboratoryId])
}

model LabRequest {
  id String @id @default(uuid()) @db.Uuid
  treatmentId String @unique @db.Uuid
  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  status String @default("to_request") @db.VarChar(16)
  laboratory String @default("") @db.VarChar(150)
  cost Decimal @default(0) @db.Decimal(12, 2)
  currency String @default("USD") @db.VarChar(3)
  material String @default("") @db.VarChar(100)
  shade String @default("") @db.VarChar(40)
  instructions String @default("") @db.VarChar(2000)
  requestDate DateTime? @db.Date
  dueDate DateTime? @db.Date
  receivedDate DateTime? @db.Date
  createdById String
  createdBy User @relation("LabRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events LabRequestEvent[]
  @@index([patientId, status, createdAt])
  @@index([roomId, status])
}

model LabRequestEvent {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  request LabRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  action String @db.VarChar(16)
  date DateTime @db.Date
  actorId String
  actor User @relation("LabRequestEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  recordedAt DateTime @default(now())
  @@index([requestId, recordedAt])
}
model TreatmentTooth {
  treatmentId String @db.Uuid
  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  tooth Int
  surfaces String[]
  role String @db.VarChar(12)
  @@id([treatmentId, tooth])
}
model TreatmentEvent {
  id String @id @default(uuid()) @db.Uuid
  treatmentId String @db.Uuid
  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  status String @db.VarChar(16)
  date DateTime @db.Date
  notes String
  actorId String
  recordedAt DateTime @default(now())
  @@index([treatmentId, recordedAt])
}

model TreatmentPlan {
  id String @id @default(uuid()) @db.Uuid
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  number Int
  createdAt DateTime @default(now())
  actorId String?
  treatments Treatment[]
  totals ClinicalRecord[]
  payments Payment[]
  @@unique([patientId, number])
  @@unique([id, patientId])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  planId String? @db.Uuid
  plan TreatmentPlan? @relation(fields: [planId, patientId], references: [id, patientId], onDelete: Restrict)
  amount Decimal @db.Decimal(18, 2)
  currency Currency
  baseCurrency Currency
  baseAmount Decimal @db.Decimal(18, 2)
  lbpPerUsd Decimal? @db.Decimal(18, 6)
  method String @db.VarChar(24)
  date DateTime @db.Date
  note String @default("") @db.VarChar(4000)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  recordedAt DateTime @default(now())
  @@index([patientId, planId, date])
  @@index([roomId, date])
}

model PatientFile {
  id String @id @default(uuid()) @db.Uuid
  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  roomId Int
  room SurgicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  storedName String @unique @db.VarChar(80)
  originalName String @db.VarChar(255)
  kind String @db.VarChar(12)
  mimeType String @db.VarChar(80)
  size Int
  tooth Int?
  date DateTime @db.Date
  description String @default("") @db.VarChar(2000)
  uploadedById String
  uploadedBy User @relation("PatientFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([patientId, date, createdAt])
  @@index([roomId, kind])
}
