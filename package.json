{
  "name": "netdenty",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:web": "npm run dev -w @clinic/web",
    "build": "npm run build -w @clinic/shared && npm run build -w @clinic/web && npm run build -w @clinic/api && npm run build -w @clinic/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "dentist:create": "tsx apps/api/src/create-dentist.ts",
    "admin:create": "tsx apps/api/src/create-admin.ts",
    "data:reset": "tsx apps/api/src/reset-data.ts",
    "api:start": "node apps/api/dist/server.js",
    "desktop:start": "node scripts/dev.mjs",
    "desktop:package": "npm run build && node scripts/stage.mjs && electron-builder --config electron-builder.yml --win nsis",
    "desktop:unpacked": "npm run build && node scripts/stage.mjs && electron-builder --config electron-builder.yml --win --dir",
    "postinstall": "npm run db:generate",
    "test:desktop": "tsx tests/electron.smoke.ts",
    "test:patients": "tsx tests/patients.smoke.ts",
    "test:access": "tsx tests/access.smoke.ts",
    "test:appearance": "npm run build -w @clinic/web && tsx tests/appearance.smoke.ts",
    "format": "prettier --write . --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.57.0",
    "@types/node": "22.19.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.2",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.11",
    "vite": "7.3.6",
    "prettier": "3.7.4"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
